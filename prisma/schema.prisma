generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkAuthorization {
  US_CITIZEN
  PERMANENT_RESIDENT
  WORK_VISA
  NEEDS_SPONSORSHIP
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum Workplace {
  REMOTE
  HYBRID
  ONSITE
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SkillWeight {
  REQUIRED
  NICE_TO_HAVE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE
  APPLICATION_UPDATE
  JOB_MATCH
  COMPANY_POST
  COMMENT
  RECOMMENDATION
}

enum PostKind {
  UPDATE
  JOB_SHARE
  HIRING
}

enum AnnouncementStatus {
  OPEN
  CLOSED
}

enum BillingPlan {
  FREE
  STARTER
  GROWTH
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  role               UserRole
  name               String
  headline           String?
  location           String?
  bio                String?
  portfolioUrl       String?
  desiredSalaryMin   Int?
  desiredSalaryMax   Int?
  workAuthorization  WorkAuthorization?
  openToWork         Boolean            @default(false)
  avatarUrl          String?
  status             UserStatus         @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  company            Company?
  resumes            Resume[]
  applications       Application[]      @relation("CandidateApplications")
  applicationEvents  ApplicationEvent[]
  savedJobs          SavedJob[]
  savedSearches      SavedSearch[]
  reports            JobReport[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  userSkills         UserSkill[]
  experiences        Experience[]
  education          Education[]
  requestedConnections Connection[]     @relation("RequestedConnections")
  receivedConnections Connection[]      @relation("ReceivedConnections")
  companyFollows     CompanyFollow[]
  conversationsA     Conversation[]     @relation("ConversationA")
  conversationsB     Conversation[]     @relation("ConversationB")
  messages           Message[]
  notifications      Notification[]
  posts              Post[]
  postLikes          PostLike[]
  postComments       PostComment[]
  projects           Project[]
  givenRecommendations    Recommendation[] @relation("RecAuthor")
  receivedRecommendations Recommendation[] @relation("RecSubject")
  announcements           Announcement[]
  announcementApplications AnnouncementApplication[]

  @@index([role, status])
  @@index([name])
}

model RefreshToken {
  id        String    @id @default(cuid())
  familyId  String
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Company {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  slug        String   @unique
  website        String?
  logoUrl        String?
  description    String?
  industry       String?
  headquarters   String?
  employeeCount  Int?
  foundedYear    Int?
  plan           BillingPlan @default(FREE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]
  invoices       Invoice[]
  followers      CompanyFollow[]
  posts          Post[]
}

model Invoice {
  id        String        @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      BillingPlan
  amountUsd Int
  status    InvoiceStatus @default(PAID)
  issuedAt  DateTime      @default(now())
  hostedUrl String?

  @@index([companyId, issuedAt])
}

model Job {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  title          String
  slug           String         @unique
  descriptionMd  String
  employmentType EmploymentType
  workplace      Workplace
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  currency       String         @default("USD")
  seniority      Seniority
  status         JobStatus      @default(DRAFT)
  featured       Boolean        @default(false)
  featuredUntil  DateTime?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  skills       JobSkill[]
  applications Application[]
  savedBy      SavedJob[]
  reports      JobReport[]

  @@index([status, publishedAt])
  @@index([featured, publishedAt])
  @@index([companyId])
  @@index([employmentType])
  @@index([workplace])
  @@index([seniority])
}

model Skill {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  jobs     JobSkill[]
  users    UserSkill[]
}

model JobSkill {
  jobId    String
  skillId  String
  job      Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  weight   SkillWeight @default(REQUIRED)

  @@id([jobId, skillId])
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Resume {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  isCurrent    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([userId, isCurrent])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  resumeId    String
  job         Job               @relation(fields: [jobId], references: [id])
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id])
  resume      Resume            @relation(fields: [resumeId], references: [id])
  coverLetter String?
  status      ApplicationStatus @default(SUBMITTED)
  withdrawnAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  events      ApplicationEvent[]

  @@unique([jobId, candidateId])
  @@index([jobId, status])
  @@index([candidateId, createdAt])
}

model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String
  actor         User               @relation(fields: [actorId], references: [id])
  note          String?
  isPublic      Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

model SavedJob {
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  queryJson Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model JobReport {
  id         String       @id @default(cuid())
  jobId      String
  reporterId String
  job        Job          @relation(fields: [jobId], references: [id])
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  companyName String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())

  @@index([userId, startDate])
}

model Education {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    String
  degree    String?
  field     String?
  startYear Int?
  endYear   Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("RequestedConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ReceivedConnections", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model CompanyFollow {
  userId    String
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, companyId])
}

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantBId String
  participantA   User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  jobId          String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Post {
  id        String       @id @default(cuid())
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id])
  kind      PostKind     @default(UPDATE)
  body      String
  jobId     String?
  createdAt DateTime     @default(now())
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
  @@index([authorId])
}

model PostLike {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Recommendation {
  id           String   @id @default(cuid())
  authorId     String
  subjectId    String
  author       User     @relation("RecAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject      User     @relation("RecSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  relationship String
  body         String
  createdAt    DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([authorId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Announcement {
  id             String             @id @default(cuid())
  authorId       String
  author         User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  body           String
  location       String?
  workplace      Workplace?
  status         AnnouncementStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   AnnouncementApplication[]

  @@index([status, createdAt])
  @@index([authorId])
}

model AnnouncementApplication {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId, createdAt])
}
