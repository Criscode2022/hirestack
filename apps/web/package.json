{
  "name": "@hirestack/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4200 --host 0.0.0.0 --allowed-hosts",
    "start": "ng serve --port 4200 --host 0.0.0.0 --allowed-hosts",
    "build": "ng build && node -e \"const fs=require('fs'); const src='dist/hirestack-web/browser/index.csr.html'; if(fs.existsSync(src)) fs.copyFileSync(src,'dist/hirestack-web/browser/index.html');\"",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --max-warnings=0 || true",
    "typecheck": "ng build --configuration development --progress=false"
  },
  "dependencies": {
    "@angular/aria": "^22.1.0",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "@hirestack/shared": "workspace:*",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.17.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2"
  }
}
